# Copia estas variables en tu perfil del sistema o sesión de PowerShell. No subas secretos al repositorio.
PLANILLA_SECRET_KEY=reemplace-por-una-clave-aleatoria-larga
PLANILLA_ADMIN_USER=admin
PLANILLA_ADMIN_PASSWORD_HASH=pbkdf2:sha256:...hash-generado-con-werkzeug...
# Actívalo únicamente si la aplicación se publica con HTTPS.
PLANILLA_COOKIE_SECURE=false
FLASK_DEBUG=false
